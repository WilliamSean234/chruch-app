# Neon: DATABASE_URL = koneksi pooled (host berakhiran -pooler), DIRECT_URL = koneksi langsung (untuk migrasi)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DBNAME?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# NextAuth v5 (isi dengan string acak panjang, mis. hasil: npx auth secret)
AUTH_SECRET=""

# Akun Superadmin pertama yang dibuat oleh seed
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ganti-password-ini"

# Zona waktu gereja (dipakai saat menghitung jam acara)
APP_TIMEZONE="Asia/Jakarta"

# Notifikasi HP (Web Push). Buat kunci sekali: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT="mailto:admin@gereja.org"
# CRON_SECRET=string-acak-untuk-pengingat-terjadwal
# SMTP_USER=alamat@gmail.com
# SMTP_PASS=sandi-aplikasi-google
# MAIL_FROM="Penjadwalan Gereja <alamat@gmail.com>"
# APP_URL=https://jadwal-elyon.vercel.app

# --- Produksi ---
# Di luar Vercel (VPS, Docker) wajib true supaya NextAuth mempercayai host. Di Vercel tidak perlu.
# AUTH_TRUST_HOST=true
# Tolak seed dummy di database produksi.
# DUMMY_SEED_BLOCK=1
# Catat endpoint yang lebih lambat dari sekian milidetik (0 = mati; bawaan 500 saat dev).
# LOG_SLOW_MS=1000

# Kunci enkripsi isi notulen (AES-256, 32 byte base64). WAJIB diisi di Vercel (Production) sebelum notulen bisa disimpan.
# Buat: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Mengenkripsi seluruh isi rapat (notulen, judul, tautan, tamu, alasan batal). Simpan salinannya di tempat aman: kunci hilang = isi yang sudah tersimpan tidak bisa dibuka lagi.
MINUTES_ENC_KEY=""
