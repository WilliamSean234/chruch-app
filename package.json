{
  "name": "church-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "check": "npm run typecheck && npm test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:seed:dummy": "tsx prisma/seed-dummy.ts",
    "db:seed:groups": "tsx prisma/seed-groups-dummy.ts",
    "db:seed:meetings": "tsx prisma/seed-meetings-dummy.ts",
    "db:ping": "tsx scripts/db-ping.ts",
    "db:fix-roles": "tsx scripts/fix-roles.ts",
    "db:sync-ebm": "tsx scripts/sync-ebm.ts",
    "db:sync-tki": "tsx scripts/sync-tki.ts",
    "vercel-build": "prisma generate && node scripts/migrate-deploy.js && next build"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.2",
    "next": "16.2.9",
    "next-auth": "beta",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "nodemailer": "^7.0.7",
    "web-push": "^3.6.7",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/nodemailer": "^6.4.17",
    "@types/web-push": "^3.6.4",
    "prisma": "^6.19.0",
    "tailwindcss": "^4",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0"
  }
}
